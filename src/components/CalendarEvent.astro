---
interface Props {
    title: string,
    height_: string,
    start_hour: string,
    end_hour: string,
    top: string,
    design_index: number
}

const {title, height_, start_hour, end_hour, top, design_index} = Astro.props;

const start = new Date(start_hour);
const end = new Date(end_hour);
const duration = new Date(end.getTime() - start.getTime());
// console.log(title, start_hour, end_hour)
const width_ = ((duration.getHours() - 1 + (duration.getMinutes()/60)) * 80) + "px";
const left_ = ((start.getHours() - 1 + (start.getMinutes()/60)) * 80) + "px";

const features = [
    "calendar-event--horni-sal",
    "calendar-event--velky-sal",
    "calendar-event--pinponkarna"
]

---

<div
     style=`--calendar-event-width: ${width_}; --calendar-event-height: ${height_};
      --calendar-event-left: ${left_}; --calendar-event-top: ${top}`
class:list={[
    "calendar-event",
    features[design_index]
]}>
    <div class="calendar-event__tag"></div>
    <div class="calendar-event__title">{title}</div>
</div>
