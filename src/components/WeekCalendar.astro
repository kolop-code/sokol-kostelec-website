---

import CalendarDay from "./CalendarDay.astro";
import CalendarEvent from "./CalendarEvent.astro";

const week_dates: Date[] = [];
const now = new Date(Date.now());
const diff = now.getDay() == 0 ? 6 : now.getDay() - 1;
const day_milliseconds = 24*60*60*1000;
const monday_milliseconds = Date.now() - (day_milliseconds * diff);

for (let i = 0; i < 7; i++) {
    week_dates[i] = new Date(monday_milliseconds + (i * day_milliseconds));
}

interface Time {
    loong_var: boolean,
    time: string
}

const times: Time[] = []

for (let i = 0; i < 48; i++) {
    if (i % 2 == 0) {
        times.push({loong_var: true, time: (i/2) + ":00"})
    } else times.push({loong_var: false, time: ""})
}

async function loadEvents() {
    const response = await fetch(new URL("/api/calendar/events", Astro.url));

    if (!response.ok) {
        throw new Error("Could not load calendar");
    }

    const events = await response.json();

    console.log(events);

    // Render events in your custom calendar.
}

loadEvents();

---

<div class="calendar">
    <!--<ul>-->
    <!--    <li><button>Filters</button></li>-->
    <!--</ul>-->
    <div class="calendar__calendar">
        <div class="calendar__days">
            <CalendarDay date={week_dates[0]} day_name="Pondělí"></CalendarDay>
            <CalendarDay date={week_dates[1]} day_name="Úterý"></CalendarDay>
            <CalendarDay date={week_dates[2]} day_name="Středa"></CalendarDay>
            <CalendarDay date={week_dates[3]} day_name="Čtvrtek"></CalendarDay>
            <CalendarDay date={week_dates[4]} day_name="Pátek"></CalendarDay>
            <CalendarDay date={week_dates[5]} day_name="Sobota"></CalendarDay>
            <CalendarDay date={week_dates[6]} day_name="Neděle"></CalendarDay>
        </div>
        <div class="calendar__data">
            <div class="calendar__times">
                {Array.from({length: 23}).map((_, i) => <div class="calendar__time">{(i + 1) + ":00"}</div>)}
            </div>
            <div class="calendar__days-data">
                <div class="calendar__day-data" id="calendar__monday">
                    <CalendarEvent title="test" width="240px" height="1.5rem"></CalendarEvent>
                </div>
                <div class="calendar__day-data" id="calendar__tuesday"></div>
                <div class="calendar__day-data" id="calendar__wednesday"></div>
                <div class="calendar__day-data" id="calendar__thursday"></div>
                <div class="calendar__day-data" id="calendar__friday"></div>
                <div class="calendar__day-data" id="calendar__saturday"></div>
                <div class="calendar__day-data" id="calendar__sunday"></div>
            </div>
        </div>
        <div class="calendar__title"></div>
    </div>
</div>