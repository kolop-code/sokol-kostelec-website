---

import CalendarDay from "./CalendarDay.astro";
import CalendarTime from "./CalendarTime.astro";

const week_dates: Date[] = [];
const now = new Date(Date.now());
const diff = now.getDay() == 0 ? 6 : now.getDay() - 1;
const day_milliseconds = 24*60*60*1000;
const monday_milliseconds = Date.now() - (day_milliseconds * diff);

for (let i = 0; i < 7; i++) {
    week_dates[i] = new Date(monday_milliseconds + (i * day_milliseconds));
}

interface Time {
    loong_var: boolean,
    time: string
}

const times: Time[] = []

for (let i = 0; i < 48; i++) {
    if (i % 2 == 0) {
        times.push({loong_var: true, time: (i/2) + ":00"})
    } else times.push({loong_var: false, time: ""})
}

