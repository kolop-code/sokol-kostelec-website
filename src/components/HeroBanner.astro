---
import Image from "astro/components/Image.astro";
import logo from "../../public/icons/sokol_logo.png";
import bg_image from "../../public/images/deco/sokol_4.jpg";

interface Props {
    use_bg: boolean;
    class?: string;
}

const {use_bg} = Astro.props;

---

<header class="hero">
    <div class="hero__container">
        <a class="hero__homepage" href="/"><Image class="hero__Image-logo" src={logo} alt="logo" /></a>
        <button class="hero__action--list btn">≡
        <input type="checkbox" id="hamburger-menu"></button>
        <nav class="hero__nav">
            <ul class="hero__ul">
                <li><a class="hero__action btn-action" href="/">Domů</a></li>
                <li><a class="hero__action btn-action" href="/events">Kalendář akcí</a></li>
                <li><a class="hero__action btn-action" href="/history">Historie</a></li>
                <li><a class="hero__action btn-action" href="/partitions">Oddíly</a></li>
                <li><a class="hero__action btn-action" href="/photogalery">Galerie</a></li>
                <li><a class="hero__action btn-action" href="/contacts">Kontakty</a></li>
            </ul>
        </nav>
    </div>
    {use_bg && (<div class="hero__div-container">
            <Image class="hero__Image-bg" src={bg_image} alt="sokolovna"></Image>
            <h1 class="hero__h1">TJ Sokol Kostelec nad Orlicí</h1>
        </div>)}
</header>