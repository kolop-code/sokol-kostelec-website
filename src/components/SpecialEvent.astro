---
interface Props {
    data: {
        title: string,
        start: Date,
        end: Date,
        description: string
    }
}

const {data} = Astro.props;

const onetime_event = new Date(data.start) !== new Date(data.end);
const has_description = data.description === undefined ? false : data.description.length > 0;

---

<div class="special-event">
    <h4 class="special-event__title u-center">{data.title}</h4>
    <!--<div class="special-event__date">Datum: {data.start.toLocaleDateString()}</div>-->
    <div class="special-event__from">Od: {data.start.toLocaleString()}</div>
    {onetime_event && (<div class="special-event__to">Do: {data.end.toLocaleString()}</div>)}
    {has_description && (<div class="special-event__description">{data.description}</div>)}
</div>